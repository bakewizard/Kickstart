{
    "name": "Kickstart",
    "description": "Kickstart theme for CakePHP",
    "type": "cakephp-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "cakephp/cakephp": "^5.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5.5 || ^11.1.3"
    },
    "autoload": {
        "psr-4": {
            "Kickstart\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kickstart\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    }
}
